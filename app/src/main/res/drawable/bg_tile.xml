<?xml version="1.0" encoding="utf-8"?>
<!-- activated — плитка в режиме перемещения, focused — выбрана пультом. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_fill" />
            <stroke android:width="@dimen/focus_ring" android:color="@color/accent" />
            <corners android:radius="@dimen/tile_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="@dimen/focus_ring" android:color="@color/accent" />
            <corners android:radius="@dimen/tile_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="@color/panel_stroke" />
            <corners android:radius="@dimen/tile_radius" />
        </shape>
    </item>
</selector>
