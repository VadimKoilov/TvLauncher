<?xml version="1.0" encoding="utf-8"?>
<!-- Почти чёрный фон и мягкое фиолетовое свечение сверху по центру. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/bg" />
    </item>
    <item
        android:gravity="top|fill_horizontal"
        android:height="260dp">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0"
                android:endColor="#007C7CFF"
                android:gradientRadius="50%p"
                android:startColor="@color/glow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
