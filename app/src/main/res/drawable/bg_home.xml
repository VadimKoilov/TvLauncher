<?xml version="1.0" encoding="utf-8"?>
<!-- Фон #09090B и эллиптическое свечение сверху по центру, как в наброске:
     radial-gradient(70% 30% at 50% -8%) — круг радиусом 672 сжат по вертикали до 288 (scaleY 0.4286). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="960dp"
    android:height="540dp"
    android:viewportWidth="960"
    android:viewportHeight="540">
    <path
        android:fillColor="@color/bg"
        android:pathData="M0,0h960v540h-960z" />
    <group
        android:pivotX="480"
        android:pivotY="0"
        android:scaleY="0.4286">
        <path android:pathData="M0,-100h960v1360h-960z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="480"
                    android:centerY="-100"
                    android:gradientRadius="672"
                    android:type="radial">
                    <item android:color="#3D7C7CFF" android:offset="0" />
                    <item android:color="#007C7CFF" android:offset="0.7" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
