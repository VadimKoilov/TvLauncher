<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingTop="@dimen/screen_pad_v"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:text="Все приложения"
            android:textColor="@color/text"
            android:textSize="29sp" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/label"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="-16dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="-16dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:padding="10dp"
        android:scrollbars="none" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="Точка — уже на главном экране · Долгое нажатие OK — добавить или убрать"
        android:textColor="@color/label"
        android:textSize="10.5sp" />
</LinearLayout>
